{
  "name": "express-pack-microservice-example",
  "version": "1.0.0",
  "description": "Microservice with RabbitMQ, cron jobs, and email service",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-pack": "^2.0.0",
    "mongoose": "^8.0.0",
    "zod": "^3.22.0",
    "dotenv": "^16.3.1",
    "ioredis": "^5.3.2",
    "amqplib": "^0.10.3",
    "nodemailer": "^6.9.7",
    "@express-pack/core": "^2.0.0",
    "@express-pack/auth": "^2.0.0",
    "@express-pack/validation": "^2.0.0",
    "@express-pack/cache": "^2.0.0",
    "@express-pack/queue": "^2.0.0",
    "@express-pack/scheduler": "^2.0.0",
    "@express-pack/email": "^2.0.0",
    "@express-pack/storage": "^2.0.0",
    "@express-pack/payment": "^2.0.0",
    "@express-pack/db": "^2.0.0",
    "@express-pack/utils": "^2.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/amqplib": "^0.10.4",
    "@types/nodemailer": "^6.4.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}