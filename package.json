{
  "name": "express-pack",
  "version": "2.0.0",
  "description": "🧩 express-pack is a powerful, modular, and scalable utility library that streamlines Express.js backend development. It provides a clean and extensible foundation for building robust enterprise-grade applications. With built-in modules for caching, messaging, job scheduling, authentication, authorization, multi-tenant handling, configuration management, and request validation, express-pack helps developers focus on business logic instead of repetitive setup. Each module is independently configurable and designed with clean architecture principles, offering flexibility, maintainability, and performance out of the box. Whether you are building a monolith or a microservice, express-pack provides the tools and patterns to keep your Express.js codebase organized, efficient, and production-ready.",
  "type": "module",
  "keywords": [
    "express",
    "middleware",
    "typescript",
    "dotenv",
    "winston",
    "helmet",
    "body-parser",
    "express-pack",
    "expressjs",
    "web framework",
    "nodejs",
    "node",
    "backend",
    "api",
    "middleware setup",
    "app setup",
    "node express",
    "server",
    "express middleware",
    "express configuration",
    "winston logger",
    "helmet security",
    "dotenv configuration",
    "body parser",
    "express setup",
    "quick start express",
    "express tools",
    "express helpers",
    "express app",
    "express configuration toolkit"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "require": "./dist/index.cjs",
    "import": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/index.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:serve": "npx http-server docs/api -p 8080",
    "docs:markdown": "typedoc --plugin typedoc-plugin-markdown"
  },
