{
  "name": "@express-pack/utils",
  "version": "2.0.0",
  "description": "Utility functions for Express applications - date, string, crypto, response helpers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean && tsc --emitDeclarationOnly",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "date-fns": "^3.0.6",
    "lodash-es": "^4.17.21",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "keywords": [
    "express",
    "utilities",
    "date",
    "string",
    "helpers"
  ],
  "author": "Express Pack Team",
  "license": "MIT"
}
